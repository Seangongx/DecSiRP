#include <Eigen/Sparse>
#include <Eigen/SparseCholesky>

#include <array>
#include <vector>
#include <unordered_map>
#include <unordered_set>
#include <algorithm>
#include <cmath>
#include <limits>
#include <stdexcept>

struct DualEdge
{
    std::size_t f0;
    std::size_t f1;
    double weight;
};

struct EdgeKey
{
    std::size_t a;
    std::size_t b;

    EdgeKey(std::size_t i, std::size_t j)
    {
        if (i < j) {
            a = i;
            b = j;
        } else {
            a = j;
            b = i;
        }
    }

    bool operator==(const EdgeKey& other) const
    {
        return a == other.a && b == other.b;
    }
};

struct EdgeKeyHash
{
    std::size_t operator()(const EdgeKey& e) const
    {
        return std::hash<std::size_t>{}(e.a)
             ^ (std::hash<std::size_t>{}(e.b) << 1);
    }
};

