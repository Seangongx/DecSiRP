std::vector<DualEdge>
buildDualGraph(
    const std::vector<std::vector<std::size_t>>& facets)
{
    // Associe chaque arête géométrique à toutes ses facettes incidentes.
    std::unordered_map<
        EdgeKey,
        std::vector<std::size_t>,
        EdgeKeyHash
    > edgeToFacets;

    // Première étape : construire les incidences arête-facette.
    for (std::size_t f = 0; f < facets.size(); ++f)
    {
        const auto& facet = facets[f];
        const std::size_t n = facet.size();

        // Les facettes de moins de 3 sommets sont ignorées.
        if (n < 3)
            continue;

        for (std::size_t i = 0; i < n; ++i)
        {
            const std::size_t a = facet[i];
            const std::size_t b = facet[(i + 1) % n];

            // Une arête dégénérée ne définit pas une incidence utile.
            if (a == b)
                continue;

            edgeToFacets[EdgeKey(a, b)].push_back(f);
        }
    }

    // Deuxième étape : construire le graphe dual.
    std::vector<DualEdge> dualEdges;

    for (const auto& [edge, incidentFacets] : edgeToFacets)
    {
        const std::size_t n = incidentFacets.size();

        // Bord : une seule facette incidente.
        if (n < 2)
            continue;

        // Relier chaque paire de facettes incidentes.
        for (std::size_t i = 0; i < n; ++i)
        {
            for (std::size_t j = i + 1; j < n; ++j)
            {
                dualEdges.push_back({
                    incidentFacets[i],
                    incidentFacets[j],
                    1.0
                });
            }
        }
    }

    return dualEdges;
}

std::vector<std::vector<std::size_t>>
connectedComponents(
    std::size_t n,
    const std::vector<DualEdge>& edges)
{
    std::vector<std::vector<std::size_t>> adjacency(n);

    for (const auto& e : edges)
    {
        adjacency[e.f0].push_back(e.f1);
        adjacency[e.f1].push_back(e.f0);
    }

    std::vector<bool> visited(n, false);
    std::vector<std::vector<std::size_t>> components;

    for (std::size_t i = 0; i < n; ++i)
    {
        if (visited[i])
            continue;

        components.emplace_back();
        std::queue<std::size_t> queue;

        queue.push(i);
        visited[i] = true;

        while (!queue.empty())
        {
            const auto u = queue.front();
            queue.pop();

            components.back().push_back(u);

            for (const auto v : adjacency[u])
            {
                if (!visited[v])
                {
                    visited[v] = true;
                    queue.push(v);
                }
            }
        }
    }

    return components;
}

std::vector<bool>
componentsWithSeeds(
    std::size_t n,
    const std::vector<DualEdge>& edges,
    const std::vector<int>& labels)
{
    const auto components = connectedComponents(n, edges);

    std::vector<bool> usable(n, false);

    for (const auto& component : components)
    {
        bool hasSeed = false;

        for (const auto f : component)
        {
            if (labels[f] != 0)
            {
                hasSeed = true;
                break;
            }
        }

        for (const auto f : component)
            usable[f] = hasSeed;
    }

    return usable;
}

Eigen::SparseMatrix<double>
buildLaplacian(
    std::size_t n,
    const std::vector<DualEdge>& edges)
{
    using Triplet = Eigen::Triplet<double>;

    std::vector<Triplet> triplets;
    triplets.reserve(3 * edges.size());

    for (const auto& e : edges)
    {
        triplets.emplace_back(e.f0, e.f0,  e.weight);
        triplets.emplace_back(e.f1, e.f1,  e.weight);

        triplets.emplace_back(e.f0, e.f1, -e.weight);
        triplets.emplace_back(e.f1, e.f0, -e.weight);
    }

    Eigen::SparseMatrix<double> L(n, n);

    L.setFromTriplets(
        triplets.begin(),
        triplets.end());

    return L;
}

